# Variables de entorno - Citas Médicas Backend
NODE_ENV=production
PORT=5000

# Supabase Configuration
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-clave-anonima-supabase
SUPABASE_SERVICE_KEY=tu-clave-service-role-supabase

# JWT Secret (Generar uno nuevo y seguro para producción)
JWT_SECRET=tu-super-secreto-jwt-muy-seguro-para-produccion-cambialo

# CORS Origins (URLs de frontend separadas por comas)
CORS_ORIGIN=https://tu-frontend.netlify.app

# Database (Opcional si usas Supabase)
DATABASE_URL=postgresql://usuario:password@host:puerto/database
